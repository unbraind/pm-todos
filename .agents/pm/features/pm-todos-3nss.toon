  "npm run release:check",project,codex-sol,"2026-10-07T12:55:12.426Z",local_mutation,feat/todotxt-fidelity
  "bun run release:check",project,codex-sol,"2026-10-07T12:55:12.965Z",local_mutation,feat/todotxt-fidelity
