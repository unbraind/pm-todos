  - command: "node --input-type=module -e 'import assert from '\\''node:assert/strict'\\''; import { readFileSync } from '\\''node:fs'\\''; import { execFileSync } from '\\''node:child_process'\\''; import { createRequire } from '\\''node:module'\\''; const {decode}=await import(createRequire(import.meta.url).resolve('\\''@toon-format/toon'\\'',{paths:['\\''./node_modules/@unbrained/pm-cli'\\'']})); const git=(...args)=>execFileSync('\\''git'\\'',args,{encoding:'\\''utf8'\\''}); const read=p=>decode(process.env.TRACKER_EVIDENCE_REF?git('\\''show'\\'',process.env.TRACKER_EVIDENCE_REF+'\\'':'\\''+p):readFileSync(p,'\\''utf8'\\'')); const paths=['\\''.agents/pm/issues/pm-todos-6cod.toon'\\'','\\''.agents/pm/tasks/pm-todos-p60g.toon'\\'']; let passed=0; for(const p of paths){if(read(p).comments.every(c=>!/^author=[^,]+,/.test(c.text)))passed++;} const clean=decode(git('\\''show'\\'','\\''9cddd1a:'\\''+paths[0])).comments.find(c=>c.created_at==='\\''2026-10-21T18:28:48.679Z'\\''); if(read(paths[0]).comments.filter(c=>JSON.stringify(c)===JSON.stringify(clean)).length===1)passed++; console.log('\\''Comment evidence: '\\''+passed+'\\''/3'\\''); const streams=git('\\''ls-tree'\\'','\\''-r'\\'','\\''--name-only'\\'','\\''9cddd1a'\\'','\\''--'\\'','\\''.agents/pm/history'\\'').trim().split('\\''\\n'\\'').filter(Boolean); for(const p of streams)assert.ok(readFileSync(p,'\\''utf8'\\'').startsWith(git('\\''show'\\'','\\''9cddd1a:'\\''+p)),p); console.log('\\''Historical streams preserved: '\\''+streams.length+'\\''/'\\''+streams.length); assert.equal(passed,3);'"
