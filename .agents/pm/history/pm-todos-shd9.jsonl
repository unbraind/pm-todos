{"ts":"2026-08-31T10:43:08.490Z","author":"claude-orchestrator","author_source":"asserted","agent_harness":"claude-code","agent_instance":"c41a528b9f424137989cc889","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-todos-shd9"},{"op":"add","path":"/metadata/title","value":"pm-todos runs CodeQL but received no dependency updates, because it had no Dependabot configuration"},{"op":"add","path":"/metadata/description","value":"pm-todos runs a codeql workflow but had no .github/dependabot.yml at all, so it received no dependency updates of any kind: no npm bumps, and no bumps for the pinned github/codeql-action commits its own scanner depends on. Those two actions are pinned to db488ddef3bf6cb639b32c2e9a7c0a7ea8271d28 and nothing was ever going to move them. Worse, the first time Dependabot did arrive it would have arrived as the fleet-wide split-pair deadlock: init and analyze are opened as two separate pull requests and must carry the same version, so each one alone fails the codeql check and neither can go green. Measured 2026-08-31 in unbraind/pm-gantt-chart 87 and 88. This adds the npm and github-actions ecosystems on a weekly schedule with a codeql-action group, so updates start arriving and arrive in a shape that can pass."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-31T10:43:08.490Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-31T10:43:08.490Z"},{"op":"add","path":"/metadata/author","value":"claude-orchestrator"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"9e56ca94adb3c0e3544b86047451bc770523ea6171352d3e8949a42fae3ac66d","item_hash_version":2,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"}}}}
