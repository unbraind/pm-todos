{"ts":"2026-09-05T20:35:32.924Z","author":"codex","author_source":"configured","agent_harness":"claude-code","agent_model":"claude-opus-5","agent_model_source":"probe","agent_instance":"59a3f96f5752cae67ab54712","agent_provenance":{"model":{"value":"claude-opus-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null,"version":{"value":"2.1.261","source":"probe"}},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-todos-zbe0"},{"op":"add","path":"/metadata/title","value":"Publish attestation gate misses a publish routed through a declaration keyword or a braced expansion"},{"op":"add","path":"/metadata/description","value":"The gate resolves a command held in a shell variable so a publish routed through one is still audited, but it skipped a command position that still held an expansion. Two independent holes let an unattested publish through while an attested sibling in the same file satisfied the non-vacuity check. First, the scalar indexer takes a binding written bare or with export only, so readonly NPM=npm, declare NPM=npm, typeset NPM=npm and local NPM=npm all left the NPM binding unindexed and the publish invisible. Second, the tokenizer treated the brace of a parameter expansion as a brace-group separator, so a braced expansion in command position split into three words and read as a command named publish. Both were confirmed by executing the gate, not by reading it."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-09-05T20:35:32.924Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-09-05T20:35:32.924Z"},{"op":"add","path":"/metadata/author","value":"codex"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"62f010e5d03466b8817d71dcbdb985fc7486373640946a87c79ac990c2a11bc9","item_hash_version":3,"message":"","event_class":"substantive","record_hash_version":1,"record_hash":"5e9bb285e7946a4dd76cc40a07b345eb3361a90efb9121666b93d87d1bf68382"}
