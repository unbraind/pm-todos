 --test-name-pattern='todos sync does not overwrite the source file when an import line drops' test/import-close-reason.test.ts","scope":"project","note":"todos sync does not overwrite the source file when an import line drops"},{"command":"PM_PATH=.agents/pm PM_GLOBAL_PATH=.agents/pm-global node --test --test-name-pattern='withDroppedReport attaches the dropped report and a non-zero exit code' test/import-helpers.test.ts","scope":"project","note":"withDroppedReport attaches the dropped report and a non-zero exit code"},{"command":"PM_PATH=.agents/pm PM_GLOBAL_PATH=.agents/pm-global node --test --test-name-pattern='withDroppedReport leaves a clean result and the exit code untouched' test/import-helpers.test.ts","scope":"project","note":"withDroppedReport leaves a clean result and the exit code untouched"}]}],"before_hash":"0424a85a90af964e6bfdfc048dad88fc51eb379edf80b47ab8b6839a3b6bc9e7","after_hash":"4668abfca7fef4ccaa6997b3eaa29a2d7eddf7d867bc3effb7a4f725b0dfffd1"}
